# ===== OpenWorker 中文汉化 - Git 忽略规则 =====

# 上游源码（由构建脚本自动克隆，体积大，不纳入版本库）
/openworker/

# 编译产物（安装包通过 GitHub Release 发布，不入库）
/dist/
*.exe
*.msi

# Rust 构建缓存
**/target/
**/Cargo.lock

# Node 依赖与构建缓存
**/node_modules/
**/.vite/
**/dist/

# Python
**/__pycache__/
*.pyc

# 临时 / 日志
*.log
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
